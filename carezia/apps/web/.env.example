# ---------- Supabase ----------
# Panel del proyecto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clave secreta. NUNCA con prefijo NEXT_PUBLIC ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------- Pagos ----------
# stripe | mercadopago | (vacío = cobro presencial, sin pasarela)
PAYMENT_PROVIDER=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# ---------- Correo ----------
RESEND_API_KEY=
EMAIL_FROM=Carezia <hola@carezia.cl>

# ---------- Recordatorios ----------
# Protege /api/cron/reminders. Genera uno con: openssl rand -hex 32
# Vercel lo envía solo en sus cron jobs; si lo ejecutas desde otro lado,
# manda la cabecera Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
